<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back_arrow"/>

            <TextView
                android:id="@+id/setupStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Configuração Inicial"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </RelativeLayout>

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Próximo Passo"
            android:textAllCaps="false"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>

        <!-- Player Names & Scores Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/section_outline"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/name_north" android:text="N: Norte" android:textColor="#AAA" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/name_south" android:text="S: Sul" android:textColor="#AAA" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:id="@+id/scoreTeam1" android:text="NS: 0" android:textColor="@android:color/white" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/scoreTeam2" android:text="EO: 0" android:textColor="@android:color/white" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView android:id="@+id/name_east" android:text="E: Este" android:textColor="#AAA" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/name_west" android:text="W: Oeste" android:textColor="#AAA" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/gameTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">

            <!-- NORTH PLAYER AREA -->
            <LinearLayout
                android:id="@+id/area_north"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:orientation="vertical"
                android:gravity="center">
                <RelativeLayout
                    android:id="@+id/border_north"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/card_north"
                        android:layout_width="50dp"
                        android:layout_height="75dp"
                        android:src="@drawable/card_back"/>
                    <ImageButton
                        android:id="@+id/edit_north"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignTop="@id/card_north"
                        android:layout_alignEnd="@id/card_north"
                        android:background="#88000000"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside"
                        android:tint="@android:color/white"
                        android:visibility="gone"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/trump_north"
                    android:layout_width="30dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="2dp"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- WEST PLAYER AREA -->
            <LinearLayout
                android:id="@+id/area_west"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:id="@+id/trump_west"
                    android:layout_width="30dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="2dp"
                    android:visibility="invisible"/>
                <RelativeLayout
                    android:id="@+id/border_west"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/card_west"
                        android:layout_width="50dp"
                        android:layout_height="75dp"
                        android:src="@drawable/card_back"/>
                    <ImageButton
                        android:id="@+id/edit_west"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignTop="@id/card_west"
                        android:layout_alignEnd="@id/card_west"
                        android:background="#88000000"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside"
                        android:tint="@android:color/white"
                        android:visibility="gone"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- EAST PLAYER AREA -->
            <LinearLayout
                android:id="@+id/area_east"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center">
                <RelativeLayout
                    android:id="@+id/border_east"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/card_east"
                        android:layout_width="50dp"
                        android:layout_height="75dp"
                        android:src="@drawable/card_back"/>
                    <ImageButton
                        android:id="@+id/edit_east"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignTop="@id/card_east"
                        android:layout_alignEnd="@id/card_east"
                        android:background="#88000000"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside"
                        android:tint="@android:color/white"
                        android:visibility="gone"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/trump_east"
                    android:layout_width="30dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="2dp"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- SOUTH PLAYER AREA -->
            <LinearLayout
                android:id="@+id/area_south"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/trump_south"
                    android:layout_width="30dp"
                    android:layout_height="45dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="invisible"/>
                <RelativeLayout
                    android:id="@+id/border_south"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/card_south"
                        android:layout_width="50dp"
                        android:layout_height="75dp"
                        android:src="@drawable/card_back"/>
                    <ImageButton
                        android:id="@+id/edit_south"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignTop="@id/card_south"
                        android:layout_alignEnd="@id/card_south"
                        android:background="#88000000"
                        android:src="@android:drawable/ic_menu_edit"
                        android:scaleType="centerInside"
                        android:tint="@android:color/white"
                        android:visibility="gone"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- Trump Card CENTER (used during selection) -->
            <RelativeLayout
                android:id="@+id/trump_selection_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:visibility="visible">
                <TextView
                    android:id="@+id/trump_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Trunfo"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <ImageView
                    android:id="@+id/trump_card"
                    android:layout_width="60dp"
                    android:layout_height="90dp"
                    android:layout_below="@id/trump_label"
                    android:src="@drawable/card_back"/>
                <ImageButton
                    android:id="@+id/edit_trump"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignTop="@id/trump_card"
                    android:layout_alignEnd="@id/trump_card"
                    android:background="#88000000"
                    android:src="@android:drawable/ic_menu_edit"
                    android:scaleType="centerInside"
                    android:tint="@android:color/white"
                    android:visibility="gone"/>
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Naming Overlay -->
    <LinearLayout
        android:id="@+id/namingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolhe o teu lugar"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- North Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <EditText
                android:id="@+id/input_north"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jogador Norte"
                android:textColor="@android:color/white"
                android:textColorHint="#AAA"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"/>
            <ImageButton
                android:id="@+id/btn_pick_north"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="@android:color/white"
                android:contentDescription="Ocupar lugar Norte"/>
        </LinearLayout>

        <!-- West Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <EditText
                android:id="@+id/input_west"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jogador Oeste"
                android:textColor="@android:color/white"
                android:textColorHint="#AAA"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"/>
            <ImageButton
                android:id="@+id/btn_pick_west"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="@android:color/white"
                android:contentDescription="Ocupar lugar Oeste"/>
        </LinearLayout>

        <!-- East Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <EditText
                android:id="@+id/input_east"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jogador Este"
                android:textColor="@android:color/white"
                android:textColorHint="#AAA"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"/>
            <ImageButton
                android:id="@+id/btn_pick_east"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="@android:color/white"
                android:contentDescription="Ocupar lugar Este"/>
        </LinearLayout>

        <!-- South Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/input_south"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Jogador Sul"
                android:textColor="@android:color/white"
                android:textColorHint="#AAA"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"/>
            <ImageButton
                android:id="@+id/btn_pick_south"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="@android:color/white"
                android:contentDescription="Ocupar lugar Sul"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Jogadores"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</FrameLayout>
