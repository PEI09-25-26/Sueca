<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/section_outline"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Game ID -->
    <TextView
        android:id="@+id/matchItemGameId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jogo: —"
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#40FFFFFF" />

    <!-- Position + Trump side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/matchItemPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Posição: ?"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/matchItemTrump"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trunfo: ?"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Score -->
    <TextView
        android:id="@+id/matchItemScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pontuação: — — —"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <!-- Winner -->
    <TextView
        android:id="@+id/matchItemWinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vencedor: —"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Starting Hand -->
    <TextView
        android:id="@+id/matchItemHand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1AFFFFFF"
        android:padding="8dp"
        android:text="Mão inicial: —"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

</LinearLayout>
