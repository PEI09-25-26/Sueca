<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating draggable panel shown when a trick is completed.
    Added programmatically to the activity's content view so it floats
    over the camera/mesa WITHOUT blocking the top action bar.
    Drag handle at the top lets users move it away from cards.
    Style matches the app's dark nautical theme.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trickReviewOverlayCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="20dp"
    app:cardBackgroundColor="#F01A2E44">

    <LinearLayout
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Drag handle bar — touch here to move the panel -->
        <LinearLayout
            android:id="@+id/trickReviewDragHandle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#1A124E78"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Grip pill indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="#8000BFFF"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Arrastar"
                android:textColor="#6600BFFF"
                android:textSize="10sp"
                android:textStyle="italic"
                android:gravity="start|center_vertical" />
        </LinearLayout>

        <!-- 1 dp separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Content body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Icon + title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅"
                    android:textSize="20sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/trickOverlayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Volta concluída"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Message -->
            <TextView
                android:id="@+id/trickOverlayMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirma se as quatro cartas na mesa estão corretas antes de avançar para a próxima volta."
                android:textColor="#CCB0C8E0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/trickOverlayBtnFix"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="Corrigir"
                    android:textColor="#FFFF9900"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <Button
                    android:id="@+id/trickOverlayBtnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Confirmar"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF007AFF"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
