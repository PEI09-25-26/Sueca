<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back_arrow"/>

    <TextView
        android:id="@+id/txtRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sala: ---"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/txtSeatHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Escolhe o teu lugar (+)"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtHybridRoleInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Define o teu papel na partida"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:alpha="0.85" />

    <Switch
        android:id="@+id/switchVirtualRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Entrar como jogador virtual"
        android:textColor="@android:color/white"
        android:checked="true" />

    <LinearLayout
        android:id="@+id/botActionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddRandomBot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="+ Random"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="#26FFFFFF"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAgent1Bot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="+ Fraco"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="#26FFFFFF"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAgent2Bot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="+ Average"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="#26FFFFFF"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAgent3Bot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="+ Smart"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="#26FFFFFF"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/seatChooserLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/section_outline"
        android:padding="16dp">

        <TextView
            android:id="@+id/seatNorthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="N"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeatNorth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_below="@id/seatNorthLabel"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="24dp"
            app:rippleColor="#66FFFFFF" />

        <TextView
            android:id="@+id/txtSeatNorthPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnSeatNorth"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:text="Livre"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seatSouthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="S"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeatSouth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_above="@id/seatSouthLabel"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="24dp"
            app:rippleColor="#66FFFFFF" />

        <TextView
            android:id="@+id/txtSeatSouthPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/btnSeatSouth"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:text="Livre"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seatWestLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="W"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeatWest"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="30dp"
            android:layout_toEndOf="@id/seatWestLabel"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="24dp"
            app:rippleColor="#66FFFFFF" />

        <TextView
            android:id="@+id/txtSeatWestPlayer"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/seatWestLabel"
            android:layout_alignStart="@+id/seatWestLabel"
            android:layout_marginStart="-15dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Livre"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seatEastLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:text="E"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeatEast"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="30dp"
            android:layout_toStartOf="@id/seatEastLabel"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="24dp"
            app:rippleColor="#66FFFFFF" />

        <TextView
            android:id="@+id/txtSeatEastPlayer"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/seatEastLabel"
            android:layout_alignEnd="@+id/seatEastLabel"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="-18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Livre"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <View
            android:id="@+id/botPlacementOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtBotPlacementHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="Escolhe onde colocar o bot"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </RelativeLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartHybridGame"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Iniciar jogo hibrido"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/teal_700"
        app:cornerRadius="12dp"
        android:visibility="gone"/>

</LinearLayout>
