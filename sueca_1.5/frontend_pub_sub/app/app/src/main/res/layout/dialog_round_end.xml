<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:minWidth="260dp"
    android:maxWidth="300dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogRoundTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

    <!-- Thin accent divider -->
    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#CC00BFFF" />

    <!-- Message -->
    <TextView
        android:id="@+id/dialogRoundMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#BFD6E8"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="24dp" />

    <!-- Correction button (only shown for renúncia) -->
    <Button
        android:id="@+id/btnDialogCorrect"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="4dp"
        android:text="Corrigir Erro (Visão)"
        android:textColor="#FF9900"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:visibility="gone" />

    <!-- Horizontal divider before action buttons -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A00BFFF"
        android:layout_marginBottom="4dp" />

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Secondary button (Terminar Jogo) -->
        <Button
            android:id="@+id/btnDialogSecondary"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Terminar Jogo"
            android:textColor="#8899AA"
            android:textSize="13sp"
            android:letterSpacing="0.03" />

        <!-- Primary button (Nova Ronda / Voltar ao Menu) -->
        <Button
            android:id="@+id/btnDialogPrimary"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Nova Ronda"
            android:textColor="#FF9900"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>

</LinearLayout>
